{
  "name": "agent-ping",
  "version": "0.1.0",
  "description": "Local notification dashboard for coding agents",
  "type": "module",
  "license": "MIT",
  "main": "dist/main/main/index.js",
  "bin": {
    "agent-ping": "dist/main/cli/index.js"
  },
  "files": [
    "dist/main/",
    "dist/dashboard/",
    "src/domain/",
    "src/hub/",
    "src/plugin/",
    "src/storage/",
    "LICENSE",
    "README.md",
    "!dist/**/*.map",
    "!dist/main/**/*.d.ts",
    "!dist/main/**/*.d.ts.map"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/prepack-check.mjs",
    "build:main": "tsc -p tsconfig.build.json",
    "build:dashboard": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "node scripts/run-tests.mjs --watch",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "pixi.js": "8.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron": "44.4.5"
  }
}
